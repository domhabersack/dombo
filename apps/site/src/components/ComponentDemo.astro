---
import { Code } from 'astro:components'
import type { Recipe } from '../data/components'

interface Props {
  recipe: Recipe
}
const { recipe } = Astro.props
---

<article id={`component-${recipe.id}`} data-animate="fade-up" class="flex scroll-mt-24 flex-col gap-2 rounded-xl bg-white p-2 dark:bg-neutral-900">
  <header class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 px-3 pt-2">
    <div class="flex max-w-prose min-w-0 flex-col gap-1">
      <h3 class="text-base/7 font-black text-neutral-900 dark:text-white">{recipe.name}</h3>
      <p class="text-sm/6 text-pretty text-neutral-600 dark:text-neutral-400">{recipe.description}</p>
    </div>
    <button
      type="button"
      data-copy={recipe.html}
      class="rounded-lg px-2.5 py-1.5 text-xs font-semibold text-neutral-600 transition-colors duration-150 hover:bg-neutral-100 hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 dark:text-neutral-400 dark:hover:bg-white/10 dark:hover:text-white"
    >
      <span data-copy-label>Copy HTML</span>
    </button>
  </header>
  <!-- The preview sits on the page color, so white surfaces in recipes read correctly. -->
  <div class="rounded-sm bg-neutral-50 p-6 sm:p-10 dark:bg-neutral-950">
    <Fragment set:html={recipe.html} />
  </div>
  <details class="group">
    <summary class="cursor-pointer rounded-sm px-3 py-2 text-sm/6 font-medium text-neutral-600 select-none hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white">
      View code
    </summary>
    <Code code={recipe.html} lang="html" theme="github-dark-dimmed" wrap={false} class="mt-2 max-h-96 overflow-auto rounded-sm p-5 text-xs/5" />
  </details>
</article>
