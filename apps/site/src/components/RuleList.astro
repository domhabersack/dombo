---
import type { CollectionEntry } from 'astro:content'
import { icon, icons } from '../data/icons'
import { ruleExamples } from '../data/rule-examples'

interface Props {
  rules: CollectionEntry<'rules'>[]
  /** ruleId → swipes that inspired it */
  inspiredBy: Map<string, CollectionEntry<'swipes'>[]>
}
const { rules, inspiredBy } = Astro.props

const doIcon = icon(icons.checkCircle, 'mt-0.5 size-5 shrink-0 text-success-600 dark:text-success-400')
const dontIcon = icon(icons.xCircle, 'mt-0.5 size-5 shrink-0 text-danger-600 dark:text-danger-400')

/** The rule's do and don't, each with its visual example if there is one. */
function examples(rule: CollectionEntry<'rules'>['data']) {
  const example = ruleExamples[rule.id]
  return [
    { kind: 'do', text: rule.do, html: example?.do },
    { kind: 'dont', text: rule.dont, html: example?.dont },
  ].filter((e) => e.text)
}

const statusStyles = {
  adopted: 'bg-success-100 text-success-700 dark:bg-success-500/15 dark:text-success-300',
  trial: 'bg-warning-100 text-warning-800 dark:bg-warning-500/15 dark:text-warning-300',
  proposed: 'bg-neutral-100 text-neutral-700 dark:bg-white/10 dark:text-neutral-300',
}
---

<div class="flex flex-col gap-4">
  <h3 class="text-base/7 font-black text-neutral-900 dark:text-white">Rules</h3>
  <ol class="grid gap-4 lg:grid-cols-2">
    {
      rules.map(({ data: rule }) => (
        <li id={`rule-${rule.id}`} data-animate="fade-up" class="flex scroll-mt-24 flex-col gap-3 rounded-xl bg-white p-5 target:ring-2 target:ring-neutral-300 dark:target:ring-neutral-700 dark:bg-neutral-900">
          <div class="flex items-start justify-between gap-4">
            <h4 class="text-sm/6 font-black text-neutral-900 dark:text-white">
              <a href={`#rule-${rule.id}`} class="hover:text-neutral-600 dark:hover:text-neutral-300">{rule.title}</a>
            </h4>
            <span class={`inline-flex shrink-0 items-center rounded-md px-2 py-0.5 text-xs font-medium capitalize ${statusStyles[rule.status]}`}>
              {rule.status}
            </span>
          </div>
          <p class="text-sm/6 text-pretty text-neutral-600 dark:text-neutral-400">{rule.rule}</p>
          {(rule.do || rule.dont) && (
            <div class="mt-1 grid gap-x-4 gap-y-5 sm:grid-cols-2 sm:gap-y-2 sm:grid-rows-[auto_auto]">
              {examples(rule).map(({ kind, text, html }) => (
                <figure class="grid gap-2 sm:row-span-2 sm:grid-rows-subgrid">
                  {html && (
                    <div class="flex min-h-36 items-center justify-center overflow-hidden rounded-lg bg-neutral-100 p-4 dark:bg-neutral-950" inert aria-hidden="true">
                      <Fragment set:html={html} />
                    </div>
                  )}
                  <figcaption class="flex gap-2 text-sm/6 text-neutral-700 dark:text-neutral-300">
                    <Fragment set:html={kind === 'do' ? doIcon : dontIcon} />
                    <span class="min-w-0">
                      <span class="sr-only">{kind === 'do' ? 'Do: ' : 'Don’t: '}</span>
                      {text}
                    </span>
                  </figcaption>
                </figure>
              ))}
            </div>
          )}
          {inspiredBy.get(rule.id)?.length ? (
            <p class="flex flex-wrap items-center gap-1.5 text-xs/5 text-neutral-500 dark:text-neutral-400">
              Inspired by
              {inspiredBy.get(rule.id)!.map((swipe) => (
                <a href={`#swipe-${swipe.id}`} class="rounded-md bg-neutral-100 px-2 py-0.5 font-medium text-neutral-700 transition-colors duration-150 hover:bg-neutral-200 dark:bg-white/10 dark:text-neutral-300 dark:hover:bg-white/15">
                  {swipe.data.title}
                </a>
              ))}
            </p>
          ) : null}
        </li>
      ))
    }
  </ol>
</div>
