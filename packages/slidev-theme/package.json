{
  "name": "@domhabersack/slidev-theme-dombo",
  "version": "0.1.0",
  "description": "Slidev theme for Dom Habersack's design system: master layouts and components built on @domhabersack/tokens.",
  "type": "module",
  "license": "MIT",
  "author": "Dom Habersack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domhabersack/dombo.git",
    "directory": "packages/slidev-theme"
  },
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=22.12.0",
    "slidev": ">=52.0.0"
  },
  "files": [
    "components",
    "layouts",
    "setup",
    "styles",
    "utils",
    "uno.config.ts",
    "example.md"
  ],
  "scripts": {
    "dev": "slidev example.md",
    "export": "slidev export example.md"
  },
  "dependencies": {
    "@domhabersack/tokens": "^0.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0"
  },
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "transition": "fade-out",
      "aspectRatio": "16/9",
      "canvasWidth": 980,
      "fonts": {
        "sans": "Inter Variable",
        "mono": "JetBrains Mono Variable",
        "provider": "none"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0"
  }
}
